# ตัวที่ต้องตั้งมีตัวเดียวคือ DATABASE_URL (บน Railway ใช้ ${{Postgres.DATABASE_URL}})
# ค่าอื่นทั้งหมด (รหัสผ่าน, App ID/Secret ของ Meta, Verify token) ตั้งผ่านหน้าเว็บของระบบได้เลย
DATABASE_URL=postgresql://user:password@localhost:5432/dm_automation

# ---------- ไม่บังคับ: ถ้าตั้งไว้จะใช้ค่านี้แทนค่าที่กรอกในหน้าเว็บ ----------
# ADMIN_PASSWORD=
# META_APP_ID=
# META_APP_SECRET=
# META_VERIFY_TOKEN=
# Instagram Login (คู่มือขั้นที่ 5): Instagram app secret และ App secret ของแอปนั้น (ถ้าเป็นแอปแยกจาก META_APP_ID)
# INSTAGRAM_APP_SECRET=
# INSTAGRAM_META_APP_SECRET=
# URL ของระบบ (บน Railway หาให้เองอัตโนมัติ)
# PUBLIC_BASE_URL=https://your-domain.example.com
# กุญแจลับ (ถ้าไม่ตั้ง ระบบสร้างจาก DATABASE_URL ให้เอง)
# AUTH_SECRET=

# ชื่อร้าน/อีเมลติดต่อ แสดงในหน้า /privacy และ /data-deletion
# BUSINESS_NAME=
# CONTACT_EMAIL=

# ลิมิตการส่งต่อชั่วโมงของแต่ละบัญชี (0 = ไม่จำกัด) ส่วนที่เกินจะรอคิวส่งเมื่อพ้นช่วง 1 ชั่วโมง ไม่หาย
# DM ที่ตอบคอมเมนต์ (Private Reply): Meta ให้ Instagram 750 ครั้ง/ชม. → ค่าเริ่มต้น 720
# INSTAGRAM_PRIVATE_REPLY_PER_HOUR=720
# FACEBOOK_PRIVATE_REPLY_PER_HOUR=0
# DM ทุกแบบ (ปกติไม่ต้องตั้ง — Meta ไม่ได้จำกัดรายชั่วโมง)
# INSTAGRAM_DM_PER_HOUR=0
# FACEBOOK_DM_PER_HOUR=0

# เขตเวลาที่ใช้แบ่งสถิติรายวัน
# APP_TIMEZONE=Asia/Bangkok

# เวอร์ชัน Graph API
# GRAPH_API_VERSION=v23.0
