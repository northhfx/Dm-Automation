# คัดลอกไฟล์นี้เป็น .env.local (ตอนรันบนเครื่อง) หรือใส่ค่าเหล่านี้ใน Variables ของ Railway

# ฐานข้อมูล PostgreSQL (บน Railway ใช้ ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgresql://user:password@localhost:5432/dm_automation

# จาก Meta App Dashboard → App settings → Basic
META_APP_ID=
META_APP_SECRET=

# ตั้งเองเป็นคำอะไรก็ได้ แล้วใส่ค่าเดียวกันในช่อง "Verify token" ตอนตั้ง Webhook
META_VERIFY_TOKEN=

# รหัสผ่านสำหรับเข้าหน้าแดชบอร์ด
ADMIN_PASSWORD=

# ข้อความสุ่มยาว 32 ตัวอักษรขึ้นไป (ใช้เข้ารหัส token และ session) — ห้ามเปลี่ยนหลังเชื่อมเพจแล้ว
AUTH_SECRET=

# URL ของระบบที่ deploy แล้ว (ไม่ต้องมี / ท้าย) เช่น https://dm-automation-production.up.railway.app
PUBLIC_BASE_URL=http://localhost:3000

# ---------- ไม่บังคับ ----------
# ชื่อร้าน/อีเมลติดต่อ แสดงในหน้า /privacy และ /data-deletion
BUSINESS_NAME=
CONTACT_EMAIL=

# จำนวน DM อัตโนมัติสูงสุดต่อชั่วโมง (0 = ไม่จำกัด) ส่วนที่เกินจะรอคิวส่งในชั่วโมงถัดไป
INSTAGRAM_DM_PER_HOUR=180
FACEBOOK_DM_PER_HOUR=0

# เขตเวลาที่ใช้แบ่งสถิติรายวัน
APP_TIMEZONE=Asia/Bangkok

# เวอร์ชัน Graph API
GRAPH_API_VERSION=v23.0
